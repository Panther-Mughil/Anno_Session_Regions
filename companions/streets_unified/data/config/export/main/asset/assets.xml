    <!-- STREETS UNLOCK TRIGGER -->
    <ModOp Type="addNextSibling" GUID="130236">
        <Asset>
            <Template>Trigger</Template>
            <Values>
                <Standard>
                    <GUID>2001229954</GUID>
                    <Name>Street Trigger</Name>
                </Standard>
                <Trigger>
                    <TriggerCondition>
                        <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
                        <Values>
                            <Condition />
                            <ConditionAlwaysTrue />
                        </Values>
                    </TriggerCondition>
                    <TriggerActions>
                        <Item>
                            <TriggerAction>
                                <Template>ActionUnlockAsset</Template>
                                <Values>
                                    <Action />
                                    <ActionUnlockAsset>
                                        <UnlockAssets>
                                            <Item>
                                                <Asset>1000178</Asset>
                                            </Item>
                                            <Item>
                                                <Asset>1010035</Asset>
                                            </Item>
                                            <Item>
                                                <Asset>101308</Asset>
                                            </Item>
                                            <Item>
                                                <Asset>101309</Asset>
                                            </Item>
                                            <Item>
                                                <Asset>114523</Asset>
                                            </Item>
                                            <Item>
                                                <Asset>119029</Asset>
                                            </Item>
                                            <Item>
                                                <Asset>112113</Asset>
                                            </Item>
                                        </UnlockAssets>
                                    </ActionUnlockAsset>
                                </Values>
                            </TriggerAction>
                        </Item>
                    </TriggerActions>
                    <ResetTrigger>
                        <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
                        <Values>
                            <EmptyAutoCreateValue />
                        </Values>
                    </ResetTrigger>
                </Trigger>
                <TriggerSetup />
            </Values>
        </Asset>
    </ModOp>

